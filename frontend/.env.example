# mediamtx's WHEP (WebRTC) endpoint base — camera video is played directly
# from mediamtx, not proxied through any pipeline service.
VITE_MEDIAMTX_WHEP_BASE=http://localhost:8889

# session-sse's SSE endpoint base — live session/danger-zone notifications.
VITE_SESSION_SSE_BASE=http://localhost:8095

# sessionapi's REST endpoint base — past session history.
VITE_SESSION_API_BASE=http://localhost:8090
