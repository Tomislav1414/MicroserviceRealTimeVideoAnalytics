# Copy to .env and adjust as needed. .env is gitignored.

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms
POSTGRES_DB=vms
POSTGRES_PORT=5432

# ─── Kafka ─────────────────────────────────────────────────────────────────
# Host-reachable port (e.g. for a Python client or kcat run outside Docker).
# Containers on the vms-local network should use kafka:9092 instead.
KAFKA_EXTERNAL_PORT=9094

# ─── Kafka UI ──────────────────────────────────────────────────────────────
KAFKA_UI_PORT=8080

# ─── pgAdmin (Postgres client) ─────────────────────────────────────────────
PGADMIN_PORT=8082
PGADMIN_DEFAULT_EMAIL=admin@vms.local
PGADMIN_DEFAULT_PASSWORD=admin

# ─── cAdvisor ──────────────────────────────────────────────────────────────
CADVISOR_PORT=8081

# ─── Prometheus ────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
